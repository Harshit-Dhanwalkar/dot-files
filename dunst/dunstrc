# vim: ft=cfg
# ~/.config/dunst/dunstrc

## Author  : Harshit Prashant Dhanwalkar
## Github  : @Harshit-Dhanwalkar

[global]
    monitor = 0
    follow = mouse
    # geometry = "350x180-5+38"      # width x height, offset
    # geometry = "0x450-8+38"
    width = 300
    height = (0, 300)
    # height = 300
    origin = top-right
    offset = (7, 5)
    scale = 0
    indicate_hidden = yes
    shrink = no
    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current
    progress_bar = true
    progress_bar_height = 14
    progress_bar_frame_width = 0
    progress_bar_min_width = 100
    progress_bar_max_width = 300
    progress_bar_corner_radius = 10
    progress_bar_corners = bottom-left, top-right
    font = JetBrainsMono Nerd font 10
    line_height = 2
    transparency = 0
    gap_size = 4
    # frame_color = "#000000"
    frame_color = "#ffffff"
    frame_width = 1
    separator_height = 6
    separator_color = frame # auto, foreground, frame
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 10
    icon_position = left # left, right, top , off
    # min_icon_size = 32
    min_icon_size = 64
    # max_icon_size = 48
    max_icon_size = 175
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/:${HOME}/.icons/Arashi/, Adwaita, Papirus, Papirus-Dark
    icon_corner_radius = 0
    icon_corners = all
    indicate_hidden = yes
    dmenu = /usr/bin/dmenu -l 10 -p dunst:
    browser = /usr/bin/firefox
    # browser = qutebrowser
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false
    layer = top
    force_xwayland = false
    force_xinerama = false
    separator_color = frame
    sort = yes # id, urgency_ascending, urgency_descending, update
    idle_threshold = 120
    markup = full
    #   %a  appname
    #   %s  summary
    #   %b  body
    #   %i  iconname (including its path)
    #   %I  iconname (without its path)
    #   %p  progress value if set ([  0%] to [100%]) or nothing
    #   %n  progress value if set without any extra characters
    #   %%  Literal %
    format = "<b><u>%s</u></b>\n%b\n"
    alignment = left # "left", "center" and "right"
    vertical_alignment = center # "top", "center" and "bottom"
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle # "start", "middle" and "end"
    ignore_newline = no
    show_indicators = yes #  for URLs (U) and actions (A)
    show_age_threshold = -1
    enable_timeout_bar = true
    timeout_bar_style = top
    timeout_bar_height = 4
    sticky_history = yes
    history_length = 50

[firefox]
    appname = firefox
    summary = Download Complete
    script = ~/.config/dunst/scripts/open_downloads.sh
    timeout = 8

[urgency_low]
    background        = "#0a0a0a"  # "#1e1e2e"  #"#222222"  # "#2e3440"
    foreground        = "#cfcfcf"  # "#cdd6f4"  # "#bbbbbb"  #"#eceff4"
    frame_color       = "#0a0a0a"  # "#00ffff"
    timeout_bar_color = "#ff9e64"  # "#00ffff"
    timeout           = 3
    # override_pause_level = 30
    # highlight       = "#722ae6, #e4b5cb"
    # default_icon = dialog-warning

[urgency_normal]
    # background        = "#0a0a0a"  # "#1e1e2e"  # "#005577"  # "#313244"
    # foreground        = "#ffffff"  # "#89b4fa"  # "#eeeeee"  # "#a6adc8"
    # frame_color       = "#0a0a0a"  # "#ff9e64"
    background        = "#0a0a0a"  # "#ffffff"  # "#0a0a0a"  # "#1e1e2e"  # "#005577"  # "#313244"
    foreground        = "#ffffff"  # "#89b4fa"  # "#eeeeee"  # "#a6adc8"
    frame_color       = "#0a0a0a"  #"#ff9e64"
    timeout_bar_color = "#89b4fa"  # "#ffffff"
    timeout           = 5
    # default_icon = dialog-warning

[urgency_critical]
    background        = "#580c19"  # "#bf616a"  # "#f38ba8"
    foreground        = "#ffffff"  # "#1e1e2e"  # "#11111b"  # "#eceff4"
    frame_color       = "#0a0a0a"  # "#ff0000"
    timeout_bar_color = "#bf616a"
    timeout           = 10
    # default_icon = dialog-warning
