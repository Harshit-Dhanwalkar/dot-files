snippet boilerplate
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <stdbool.h>
#include <vector>
#include <set>

typedef uint8_t u8;
typedef uint32_t u32;
typedef uint64_t u64;

typedef int32_t b32;

typedef float f32;

$0
endsnippet

snippet main
int main() {
	${1}
	return 0;
}
endsnippet

# Loop
snippet for
for(int ${1:i} = ${2:0}; $1 < ${3:n}; ++$1) {
	$0
}
endsnippet

snippet repi "for i = 0..n"
for(int i = 0; i < ${1:n}; ++ i) {
    $0
}
endsnippet

snippet repj "for j = 0..n"
for(int j = 0; j < ${1:n}; ++ j) {
    $0
}
endsnippet
